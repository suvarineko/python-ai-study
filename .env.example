# Скопируйте в .env и подставьте свой ключ: cp .env.example .env
# Сам .env в гите не лежит (см. .gitignore).

DATABASE_URL=sqlite:///./chatlab.db

# dev — заглушка, отвечает "Тест дев" (по умолчанию, сеть не нужна)
# openrouter — реальная модель через OpenRouter
AI_PROVIDER=openrouter

# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Каталог моделей и цены: https://openrouter.ai/models
# Бесплатные — с суффиксом :free. Список меняется, проверяйте фильтром Prompt pricing = FREE
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=60
OPENROUTER_SYSTEM_PROMPT=Ты — дружелюбный ассистент. Отвечай по-русски и по делу.

# --- Телеграм-бот ---
# Токен выдаёт @BotFather по команде /newbot
TELEGRAM_BOT_TOKEN=
# Адрес нашего API, к которому ходит бот
API_BASE_URL=http://127.0.0.1:8906
# Кому бот отвечает: id через запятую. Пусто — отвечает ВСЕМ, кто найдёт бота.
# Свой id узнаете так: напишите боту при непустом списке — он напечатает id в консоль.
TELEGRAM_ALLOWED_USERS=
